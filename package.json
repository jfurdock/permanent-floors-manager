{
  "name": "permanent-floors-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Store management for Permanent Floors Carpet One: quotes, orders, inventory, purchasing, scheduling, invoicing and reports.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "concurrently -k -n api,web \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "build:pages": "vite build --mode pages",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
